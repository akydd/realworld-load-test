# URL of the RealWorld backend to test against.
# When running via Docker Compose, host.docker.internal resolves to the host machine.
# To target a remote server, set this to its full URL, e.g. https://api.example.com
BASE_URL=http://host.docker.internal:8090

# How long to run the load test. Examples: 30m, 1h, 4h
DURATION=1h
