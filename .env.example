# URL of the RealWorld backend to test against.
# host.docker.internal resolves to the host machine from inside Docker.
# To target a remote server: BASE_URL=https://api.example.com
BASE_URL=http://host.docker.internal:8090

# Postgres connection string for the seeder (libpq URI).
# Must point at the same database the backend uses.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# If the password contains @ : / or other URL-special characters,
# percent-encode them (e.g. @ -> %40).
DATABASE_URL=postgres://admin:password@host.docker.internal:8095/app

# How long to run the load test. Examples: 30m, 1h, 4h
DURATION=1h

# Scenario set: "all" (five discrete scenarios) or "mixed" (one blended stream).
MODE=all

# Optional: total arrival rate (req/min) for mixed mode. Defaults to 120.
# RATE=120
